<body>
	<div class="app">
		<header class="topbar">
			<div class="brand"><span class="brand-mark">✦</span><div><strong>오늘의 메모</strong><small>작은 생각을 오래 남기는 곳</small></div></div>
			<div class="date" id="today"></div>
		</header>
		<main>
			<section class="welcome">
				<div><h1>생각을 적어두세요.</h1><p>지금 떠오른 문장을 놓치지 않도록.</p></div>
				<button class="new-button" id="newNote">＋ 새 메모</button>
			</section>
			<section class="workspace">
				<aside class="sidebar">
					<label class="search"><span>⌕</span><input id="search" type="search" placeholder="메모 검색" aria-label="메모 검색"></label>
					<div class="section-label"><span>내 메모</span><span id="noteCount">0개</span></div>
					<div class="note-list" id="noteList"></div>
				</aside>
				<article class="editor">
					<div class="editor-head"><span class="editor-status" id="editorStatus">새 메모</span><div class="icon-actions"><button class="icon-button" id="pinNote" title="메모 고정" aria-label="메모 고정">☆</button><button class="icon-button" id="deleteNote" title="메모 삭제" aria-label="메모 삭제">⌫</button></div></div>
					<input id="noteTitle" placeholder="제목을 입력하세요" aria-label="메모 제목">
					<textarea id="noteBody" placeholder="여기에 자유롭게 적어보세요..." aria-label="메모 내용"></textarea>
					<div class="editor-foot"><span id="saveInfo">저장되지 않음</span><button class="save-button" id="saveNote">저장하기</button></div>
				</article>
			</section>
		</main>
		<div class="toast" id="toast">저장했습니다.</div>
	</div>
	<script>
		const storageKey = "today-notes";
		let notes = JSON.parse(localStorage.getItem(storageKey) || "[]");
		let selectedId = null;

		const $ = (id) => document.getElementById(id);
		const title = $("noteTitle");
		const body = $("noteBody");
		const list = $("noteList");

		function formatDate(value) {
			return new Intl.DateTimeFormat("ko-KR", { month: "short", day: "numeric" }).format(new Date(value));
		}
		function persist() { localStorage.setItem(storageKey, JSON.stringify(notes)); }
		function showToast(message) {
			$("toast").textContent = message;
			$("toast").classList.add("show");
			setTimeout(() => $("toast").classList.remove("show"), 1800);
		}
		function renderList() {
			const query = $("search").value.trim().toLowerCase();
			const visible = notes.filter((note) => `${note.title} ${note.body}`.toLowerCase().includes(query)).sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.updatedAt - a.updatedAt);
			$("noteCount").textContent = `${notes.length}개`;
			list.innerHTML = visible.length ? visible.map((note) => `<button class="note-item ${note.id === selectedId ? "active" : ""}" data-id="${note.id}"><strong>${escapeHtml(note.title || "제목 없음")}</strong><small>${formatDate(note.updatedAt)} · ${escapeHtml((note.body || "내용 없음").slice(0, 28))}</small></button>`).join("") : `<div class="empty-list">아직 메모가 없어요.<br>첫 생각을 적어보세요.</div>`;
			list.querySelectorAll(".note-item").forEach((item) => item.addEventListener("click", () => selectNote(Number(item.dataset.id))));
		}
		function escapeHtml(value) { return value.replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[char])); }
		function selectNote(id) {
			selectedId = id;
			const note = notes.find((item) => item.id === id);
			if (!note) return;
			title.value = note.title; body.value = note.body;
			$("editorStatus").textContent = `마지막 수정 ${formatDate(note.updatedAt)}`;
			$("saveInfo").textContent = "자동 저장됨";
			$("pinNote").classList.toggle("pinned", note.pinned);
			$("pinNote").textContent = note.pinned ? "★" : "☆";
			renderList();
		}
		function newNote() {
			selectedId = null; title.value = ""; body.value = "";
			$("editorStatus").textContent = "새 메모"; $("saveInfo").textContent = "저장되지 않음";
			$("pinNote").classList.remove("pinned"); $("pinNote").textContent = "☆"; renderList(); title.focus();
		}
		$("saveNote").addEventListener("click", () => {
			if (!title.value.trim() && !body.value.trim()) { showToast("내용을 먼저 입력해주세요."); title.focus(); return; }
			const now = Date.now();
			if (selectedId) { const note = notes.find((item) => item.id === selectedId); note.title = title.value.trim(); note.body = body.value.trim(); note.updatedAt = now; }
			else { selectedId = now; notes.push({ id: selectedId, title: title.value.trim(), body: body.value.trim(), updatedAt: now, pinned: false }); }
			persist(); selectNote(selectedId); showToast("저장했습니다.");
		});
		$("newNote").addEventListener("click", newNote);
		$("search").addEventListener("input", renderList);
		$("deleteNote").addEventListener("click", () => {
			if (!selectedId) { showToast("삭제할 메모를 선택해주세요."); return; }
			notes = notes.filter((note) => note.id !== selectedId); persist(); newNote(); showToast("메모를 삭제했습니다.");
		});
		$("pinNote").addEventListener("click", () => {
			if (!selectedId) return;
			const note = notes.find((item) => item.id === selectedId); note.pinned = !note.pinned; persist(); selectNote(selectedId); showToast(note.pinned ? "메모를 고정했습니다." : "고정을 해제했습니다.");
		});
		body.addEventListener("input", () => { if (selectedId) $("saveInfo").textContent = "변경사항 있음"; });
		$("today").textContent = new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "long", day: "numeric", weekday: "long" }).format(new Date());
		renderList();
	</script>
</body>
</html>
